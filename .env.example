# ============================================================================
# TechEve Portal — Environment Variables
# Copy these to Vercel Project Settings → Environment Variables
# ============================================================================

# 1. Supabase Project URL & Anon Key (Required)
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Supabase Service Role Key (Required for server actions / staff invites)
# Found in: Supabase Dashboard → Project Settings → API → service_role key (secret)
# IMPORTANT: Keep this private; do not prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Production Site URL (Required for invite email links and redirects)
# Set to your Vercel deployment domain or custom domain (e.g., https://portal.techeve.in)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# 4. Optional: Resend API Key for Email Broadcasts
# RESEND_API_KEY=re_123456789...
# RESEND_FROM_EMAIL="TechEve <no-reply@techeve.in>"
