# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings → API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used ONLY in server actions that call Supabase's admin API (inviting users).
# Never expose this to the browser / never prefix it with NEXT_PUBLIC_.
# Project Settings → API → service_role key (click "Reveal").
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build the link inside invite emails (Set Password page). In local
# dev this is fine as localhost; in production, set it to your real domain,
# e.g. https://portal.techeve.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000
